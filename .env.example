# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# ".env" itself must NEVER be committed — it's already covered by .gitignore.

DB_PASSWORD=choose_a_root_password_for_the_docker_mysql_container
JWT_SECRET=a_long_random_secret_string_for_signing_jwts
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
